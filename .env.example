# ===== 服务部AI洞察平台 - 环境变量示例 =====
# 使用方法：复制本文件为 .env，并按实际环境修改后保存到项目根目录

# 数据库连接串（asyncpg 异步驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insight_ai

# 是否打印 SQL 日志（调试用，生产环境建议 false）
DB_ECHO=false

# ---- 连接池配置 ----
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30

# ---- JWT ----
SECRET_KEY=insight-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 内部邮箱域名（发邮件时无需白名单） ----
INTERNAL_EMAIL_DOMAINS=["insight.local"]

# ---- 报告生成 ----
MAX_CONCURRENT_TASKS=5
GENERATION_TIMEOUT_SECONDS=1800
# 模拟生成（True 时不调用真实模型 API，用于开发/演示）
GENERATION_SIMULATE=true
GENERATION_STEP_DELAY=0.5

# ---- 模型调用 ----
MODEL_CALL_TIMEOUT=60
MODEL_TEST_TIMEOUT=15

# ---- 邮件 ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SENDER=
# 模拟发送（True 时不真正调用 SMTP）
EMAIL_SIMULATE=true

# ---- Redis / 并发 / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- 外部数据抓取 ----
FETCHER_DEFAULT_TIMEOUT=10.0
FETCHER_DEFAULT_RETRIES=2
FETCHER_DEFAULT_MAX_LENGTH=5000
FETCHER_ENABLE_PLAYWRIGHT=true

# ---- 临时文件 ----
TEMP_DIR=./temp

